{
  "name": "municipio/wp-plugin-municipio-extended",
  "description": "WordPress plugin that adds more features to Municipio",
  "type": "wordpress-plugin",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "AGPL-3.0",
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "composer/installers": true
    }
  },
  "extra": {
    "installer-name": "municipio-extended",
    "installer-paths": {
      "vendor/{$vendor}/{$name}/": [
        "vendor:wpackagist-plugin",
        "type:wordpress-muplugin",
        "type:wordpress-plugin",
        "type:wordpress-theme"
      ]
    }
  },
  "autoload": {
    "psr-4": {
      "MunicipioExtended\\": "psr-4/"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "require": {
    "elasticsearch/elasticsearch": "^8.14",
    "imangazaliev/didom": "^2.0"
  },
  "require-dev": {
    "municipio/wp-plugin-hbg-component-library": "v25.x-dev",
    "municipio/wp-plugin-modularity": "v25.x-dev",
    "municipio/wp-theme-municipio": "v25.x-dev",
    "wpackagist-plugin/advanced-custom-fields": "^6.3",
    "10up/elasticpress": "^5.1.3",
    "wpackagist-plugin/kirki": "^5.1"
  }
}
